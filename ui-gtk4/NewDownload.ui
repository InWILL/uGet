<?xml version="1.0" encoding="UTF-8"?>
<interface>
<object class="GtkApplicationWindow" id="window">
<property name="title">New Download</property>
<property name="default-width">600</property>
<property name="default-height">400</property>
<child>
    <object class="GtkBox">
    <property name="orientation">GTK_ORIENTATION_VERTICAL</property>
    <child>
        <object class="GtkNotebook">
        <property name="tab-pos">left</property>
        <property name="vexpand">true</property>
        <child>
            <object class="GtkNotebook">
            <property name="hexpand">true</property>
            <child>
                <object class="GtkBox">
                <property name="orientation">GTK_ORIENTATION_VERTICAL</property>
                <child>
                    <object class="GtkBox">
                    <property name="orientation">GTK_ORIENTATION_HORIZONTAL</property>
                    <child>
                        <object class="GtkLabel">
                        <property name="label">URL:</property>
                        <property name="width-chars">10</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkEntry">
                        </object>
                    </child>
                    </object>
                </child>
                <child>
                    <object class="GtkBox">
                    <property name="orientation">GTK_ORIENTATION_HORIZONTAL</property>
                    <child>
                        <object class="GtkLabel">
                        <property name="label">Mirrors:</property>
                        <property name="width-chars">10</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkEntry">
                        </object>
                    </child>
                    </object>
                </child>
                <child>
                    <object class="GtkBox">
                    <property name="orientation">GTK_ORIENTATION_HORIZONTAL</property>
                    <child>
                        <object class="GtkLabel">
                        <property name="label">File:</property>
                        <property name="width-chars">10</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkEntry">
                        </object>
                    </child>
                    </object>
                </child>
                <child>
                    <object class="GtkBox">
                    <property name="orientation">GTK_ORIENTATION_HORIZONTAL</property>
                    <child>
                        <object class="GtkLabel">
                        <property name="label">Referrer:</property>
                        <property name="width-chars">10</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkEntry">
                        </object>
                    </child>
                    </object>
                </child>
                <child>
                    <object class="GtkBox">
                    <property name="orientation">GTK_ORIENTATION_HORIZONTAL</property>
                    <child>
                        <object class="GtkLabel">
                        <property name="label">Max Connections:</property>
                        <property name="width-chars">10</property>
                        </object>
                    </child>
                    <child>
                        <object class="GtkEntry">
                        </object>
                    </child>
                    </object>
                </child>
                </object>
            </child>
            <child type="tab">
                <object class="GtkLabel">
                <property name="label">General</property>
                </object>
            </child>
            <child>
                <object class="GtkLabel">
                <property name="label">Content for Tab 2</property>
                </object>
            </child>
            <child type="tab">
                <object class="GtkLabel">
                <property name="label">Advanced</property>
                </object>
            </child>
            </object>
        </child>
        <child type="tab">
            <object class="GtkLabel">
            <property name="label">Category</property>
            </object>
        </child>
        <child>
            <object class="GtkLabel">
            <property name="label">Content for Tab 2</property>
            </object>
        </child>
        <child type="tab">
            <object class="GtkLabel">
            <property name="label">Options</property>
            </object>
        </child>
        </object>
    </child>
    <child>
        <object class="GtkBox">
        <property name="orientation">GTK_ORIENTATION_HORIZONTAL</property>
        <property name="halign">end</property>
        <child>
            <object class="GtkButton" id="cancel-button">
            <property name="label">Cancel</property>
            </object>
        </child>
        <child>
            <object class="GtkButton" id="OK-button">
            <property name="label">  OK  </property>
            </object>
        </child>
        </object>
    </child>
    </object>
</child>
</object>
</interface>
